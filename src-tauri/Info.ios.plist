<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS 专属 Info.plist 增量。Tauri 会自动找 tauri.conf.json 同目录下的
  Info.ios.plist 并合并进 tauri ios init 生成的那份
  （config.schema.json 的 bundle.iOS.infoPlist 原文写明这条），
  所以不用去动 gen/apple/（那目录是 .gitignore 掉的，CI 每次 init 重新生成）。

  🔴 锁竖屏：产品形态是"手机立在桌上当摆件"，一个机位演完程（《场景与美术方案
     说明书》§1）。横过来整套构图就不成立了，而且 tauri ios init 生成的工程
     默认横竖屏全开。iPad 那条一起锁上。
-->
<plist version="1.0">
<dict>
  <!-- 出口合规（9-4 商店包）：只用系统 TLS 和平台登录，不含自研加密＝豁免类。不声明的话每次上传都停在「缺少合规信息」 -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- iPad 只支持竖屏必须声明全屏运行（不进多任务分屏），否则 ASC 上传报 "need to include all of the orientations"（9-4 build 56 被拒） -->
  <key>UIRequiresFullScreen</key>
  <true/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
</dict>
</plist>
