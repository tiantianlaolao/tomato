{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "番茄时钟",
  "version": "0.1.0",
  "identifier": "com.tybbtech.tomato",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "番茄时钟",
        "label": "main",
        "width": 980,
        "height": 700,
        "minWidth": 560,
        "minHeight": 520,
        "center": true
      },
      {
        "title": "强制休息",
        "label": "rest",
        "url": "rest.html",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "closable": false
      },
      {
        "title": "番茄水豚",
        "label": "pet",
        "url": "pet.html",
        "width": 260,
        "height": 250,
        "visible": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "closable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
